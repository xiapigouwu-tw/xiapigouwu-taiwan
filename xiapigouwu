<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Shopee 蝦皮購物優惠券領取中心</title>
<script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#FFF7F5] min-h-screen flex justify-center p-4">
<div class="w-full max-w-[380px] pt-2">
  <div class="border border-dashed border-[#E8A89A] bg-[#FFF0EB] rounded-[16px] p-4">
    <p class="text-[#B94A3A] font-bold text-[14px]">全站購物優惠券</p>
    <p class="text-[#E64A19] font-black text-[28px] mt-1">折 $398</p>
    <p class="text-[11px] text-[#666] mt-2">使用條件：低消 $0.01</p>
    <p class="text-[11px] text-[#666]">有效期限：即日起至 09.30</p>
    <button class="openModal mt-4 w-full bg-[#E64A19] text-white font-bold py-3 rounded-[10px]">立即查看優惠券</button>
  </div>
  <div class="mt-4 border border-dashed border-[#E8A89A] bg-[#FFF0EB] rounded-[16px] p-4">
    <p class="text-[#B94A3A] font-bold text-[14px]">遊戲專區優惠券</p>
    <p class="text-[#E64A19] font-black text-[28px] mt-1">折 最高$3888</p>
    <p class="text-[11px] text-[#666] mt-2">使用條件：低消 $0.01</p>
    <p class="text-[11px] text-[#666]">有效期限：即日起至 09.30</p>
    <button class="openModal mt-4 w-full bg-[#E64A19] text-white font-bold py-3 rounded-[10px]">立即查看優惠券</button>
  </div>
</div>
<div id="modal" class="hidden fixed inset-0 bg-black/40 z-50 flex items-center justify-center p-4">
  <div class="bg-white rounded-[18px] w-full max-w-[340px] p-6 text-center shadow-2xl">
    <h3 class="text-[#E8734A] font-bold text-[16px]">優惠券領取</h3>
    <div class="mt-4 bg-[#FFF0EB] rounded-[12px] py-3"><p id="modalCouponName" class="text-[#E8734A] font-bold text-[15px]">全站購物優惠券</p></div>
    <p class="text-[#333] text-[13px] mt-4">請前往聯絡優惠券人員完成領取流程。</p>
    <button id="goClaim" class="mt-5 w-full bg-[#E64A19] text-white font-bold py-3.5 rounded-[12px]">前往領取優惠券</button>
    <button id="closeModal" class="mt-3 w-full bg-[#F0F0F0] text-[#666] font-bold py-3.5 rounded-[12px]">返回</button>
  </div>
</div>
<script>
  document.querySelectorAll('.openModal').forEach((b,i)=>{b.onclick=()=>{document.getElementById('modalCouponName').textContent=["全站購物優惠券","遊戲專區優惠券"][i];document.getElementById('modal').classList.remove('hidden');}});
  document.getElementById('closeModal').onclick=()=>document.getElementById('modal').classList.add('hidden');
  document.getElementById('modal').onclick=(e)=>{if(e.target.id==='modal')e.currentTarget.classList.add('hidden');}
  document.getElementById('goClaim').onclick=()=>window.location.href='https://lin.ee/PouRlwK';
</script>
</body>
</html>
